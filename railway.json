{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "healthcheckPath": "/version",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "volumes": [
      {
        "mountPath": "/config",
        "name": "esphome-config"
      },
      {
        "mountPath": "/cache",
        "name": "esphome-cache"
      }
    ]
  }
}
